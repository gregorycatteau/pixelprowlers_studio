{
  "$schema": "https://json-schema.org/draft-07/schema",
  "title": "E-OTP Alerts",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer" },
    "notes": { "type": "string" },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "window", "description", "metric", "expression"],
        "properties": {
          "id": { "type": "string" },
          "severity": { "type": "string", "enum": ["CRIT", "WARN", "INFO"] },
          "window": { "type": "string" },
          "description": { "type": "string" },
          "metric": {
            "type": "object",
            "additionalProperties": { "type": "string" },
            "minProperties": 1
          },
          "expression": { "type": "string" },
          "hints": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  },
  "required": ["version", "rules"]
}
