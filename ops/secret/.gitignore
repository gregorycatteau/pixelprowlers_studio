# ops/secret/.gitignore
# Protects keys and decrypted files from being committed

# ──────────────────────────────────────────────────────────────────────────────
# Keys (age, SSH, API keys, etc.)
# ──────────────────────────────────────────────────────────────────────────────

# All private keys in keys/ directory
keys/*.key
keys/*.pem
keys/*.priv
keys/*.private
keys/id_*
keys/*.asc
keys/*.gpg

# Age-specific
keys/age.key
keys/local.key
keys/dev.key
keys/staging.key
keys/prod.key

# ──────────────────────────────────────────────────────────────────────────────
# Decrypted files (plain secrets)
# ──────────────────────────────────────────────────────────────────────────────

# Environment files (decrypted)
*.env
!*.env.enc
.env
.env.*
!.env.*.enc

# Config files (decrypted)
*.yaml
!.sops.yaml
*.yml
!*.yml.enc
!*.yaml.enc
*.json
!*.json.enc
*.toml
!*.toml.enc

# Key files (decrypted)
*.key
!*.key.enc
*.pem
!*.pem.enc
*.crt
!*.crt.enc
*.cert
!*.cert.enc

# SSH keys
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
id_ecdsa
id_ecdsa.pub
authorized_keys
known_hosts

# ──────────────────────────────────────────────────────────────────────────────
# Temporary files
# ──────────────────────────────────────────────────────────────────────────────

*.tmp
*.temp
*.bak
*.swp
*.swo
*~
.DS_Store

# ──────────────────────────────────────────────────────────────────────────────
# ALLOW these files (whitelist)
# ──────────────────────────────────────────────────────────────────────────────

# Documentation
!README.md
!*.md

# SOPS configuration
!.sops.yaml

# Public keys (safe to commit)
!*.pub.enc
!*.public.enc

# Encrypted files (safe to commit - these are the whole point!)
!*.enc

# Keep directory structure
!.gitkeep
!.gitignore
