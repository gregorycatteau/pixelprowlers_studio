{
  "name": "pixelprowlers_studio",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "nuxt dev",
    "dev:back": "cross-env APP_ENV=dev DJANGO_SETTINGS_MODULE=studio_core.settings.dev sh -c \"cd ../backend && poetry run python manage.py runserver 0.0.0.0:8000\"",
    "dev:all": "concurrently -k \"npm:dev:back\" \"npm:dev\"",
    "dev:bootstrap": "cross-env APP_ENV=dev DJANGO_SETTINGS_MODULE=studio_core.settings.dev sh -c \"cd ../backend && poetry run python ../scripts/bootstrap_e2e.py\"",
    "dev:test:back": "cross-env APP_ENV=test DJANGO_SETTINGS_MODULE=studio_core.settings.base sh -c \"cd ../backend && poetry run python manage.py runserver 0.0.0.0:8100\"",
    "dev:test:front": "cross-env APP_ENV=test NUXT_PUBLIC_APP_ENV=test NUXT_PORT=3100 PORT=3100 nuxt dev",
    "dev:all:test": "concurrently -k \"npm:dev:test:back\" \"npm:dev:test:front\"",
    "build": "nuxt build",
    "start": "node .output/server/index.mjs",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint . --ext .ts,.vue",
    "lint:fix": "eslint . --ext .ts,.vue --fix",
    "format": "prettier -w .",
    "stylelint": "stylelint \"**/*.{vue,css}\"",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest",
    "test:run": "vitest --run",
    "test:e2e": "npx playwright test",
    "test:e2e:headed": "PWDEBUG=1 npm run test:e2e",
    "test:e2e:report": "npx playwright show-report",
    "pw:clean": "sh -c \"rm -rf playwright-report test-results reports blob-report || true\"",
    "pw:docker:run": "sh -c \"docker compose -f ../docker-compose.playwright.yml run --rm -e PPW_BASE_URL=${PPW_BASE_URL:-http://127.0.0.1:3100} -e PPW_BACKEND_HEALTH_URL=${PPW_BACKEND_HEALTH_URL:-http://127.0.0.1:8100/ready/} -e PW_SKIP_WEBSERVER=1 playwright\"",
    "playwright:install": "npx playwright install --with-deps"
  },
  "dependencies": {
    "@nuxtjs/device": "^3.2.0",
    "@sentry/vue": "^7.120.4",
    "nuxt": "^4.0.1",
    "radix-vue": "^1.9.2",
    "vue": "^3.5.18",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/vite": "^4.1.12",
    "@types/node": "^22.7.6",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.4.0",
    "jsdom": "^24.1.0",
    "postcss": "^8.5.6",
    "postcss-html": "^1.7.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "start-server-and-test": "^2.1.2",
    "stylelint": "^16.23.1",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-config-standard": "^39.0.0",
    "stylelint-config-tailwindcss": "^1.0.0",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.1",
    "vitest": "^2.1.1",
    "vue-tsc": "^2.1.10"
  }
}
