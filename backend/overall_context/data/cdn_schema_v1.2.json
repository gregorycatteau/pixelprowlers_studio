          "priority_hint": 0.9
        }
      ]
    },
    "recommended_tags": [
      "critical_context",
      "design_system",
      "policy_reference",
      "client_scope",
      "pentest_sensitive",
      "fallback_content",
      "legal_constraints",
      "a11y_audit",
      "interface_contract",
      "agent_instruction",
      "code_base_map",
      "anomaly_trigger"
