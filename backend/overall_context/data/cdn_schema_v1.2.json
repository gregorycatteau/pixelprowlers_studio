{
  "schema_version": "1.2.0",
  "description": "Bloc de zone logique pour le CDN PixelProwlers – v1.2. Extension v1.1 : zone_type, bindings squads/agents, RAG/FinOps/LLM policy, provenance signée, deception_controls, interfaces, SLOs/KPIs. Rétro-compatible 1.1.",
  "structure": {
    "id": "Zx",
    "code": "TAXON_PLACEHOLDER",
    "label": "Nom lisible de la zone",
