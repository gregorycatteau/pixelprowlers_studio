# PixelProwlers Studio — Backend (.env.example)
# Dupliquez ce fichier en .env (ou .env.dev / .env.prod) et remplacez les placeholders.
# ATTENTION: Ne commitez jamais vos véritables secrets (.env*) dans le dépôt Git.

# ─────────────────────────────────────────────────────────────────────────────
# Contexte applicatif
# ─────────────────────────────────────────────────────────────────────────────
# dev | test | prod | upgrade
APP_ENV=dev

# Clé Django (dev seulement). En prod, fournissez une valeur robuste via secret manager.
DJANGO_SECRET_KEY=change-me-dev-not-secret

# 1/true/on pour activer le mode debug (jamais en prod)
DJANGO_DEBUG=1

# ─────────────────────────────────────────────────────────────────────────────
# Réseau et origines de confiance
# ─────────────────────────────────────────────────────────────────────────────
# Liste séparée par des virgules
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,https://localhost:3000

# CORS (si django-cors-headers est installé)
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://localhost:3000
CORS_ALLOW_CREDENTIALS=1

# ─────────────────────────────────────────────────────────────────────────────
# Base de données
# ─────────────────────────────────────────────────────────────────────────────
# Laisser vide pour fallback SQLite local (db.sqlite3 dans backend/)
# Exemple PostgreSQL:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=

# ─────────────────────────────────────────────────────────────────────────────
# JWT (SimpleJWT) — recommandé RS256 en prod (clé privée/publique)
# ─────────────────────────────────────────────────────────────────────────────
# Fournir ces clés en prod (ne PAS commiter). Exemple de placeholders:
# JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
# ...PASTE-YOUR-PRIVATE-KEY...
# -----END PRIVATE KEY-----"
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
# ...PASTE-YOUR-PUBLIC-KEY...
# -----END PUBLIC KEY-----"
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# DRF — Throttling (valeurs par défaut raisonnables)
# ─────────────────────────────────────────────────────────────────────────────
DRF_THROTTLE_ANON=30/min
DRF_THROTTLE_USER=120/min
DRF_THROTTLE_JWT_OBTAIN=10/min
DRF_THROTTLE_JWT_REFRESH=30/min
DRF_THROTTLE_JWT_VERIFY=60/min

# ─────────────────────────────────────────────────────────────────────────────
# GraphQL
# ─────────────────────────────────────────────────────────────────────────────
GRAPHQL_MAX_DEPTH=8
# En prod, forcer true (op name requis)
GRAPHQL_REQUIRE_OPERATION_NAME=false
# Exemple: 60/m si django-ratelimit présent
GRAPHQL_RATE=

# ─────────────────────────────────────────────────────────────────────────────
# Internationalisation
# ─────────────────────────────────────────────────────────────────────────────
DJANGO_LANGUAGE_CODE=fr-fr
DJANGO_TIME_ZONE=Europe/Paris

# ─────────────────────────────────────────────────────────────────────────────
# Sécurité (activer strictement en prod)
# ─────────────────────────────────────────────────────────────────────────────
# Redirection HTTPS en prod
SECURE_SSL_REDIRECT=0
# HSTS (activer en prod avec une durée élevée)
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=1
SECURE_HSTS_PRELOAD=1

# Cookies sécurisés (activer en prod)
SESSION_COOKIE_SECURE=0
CSRF_COOKIE_SECURE=0

# SameSite (Lax recommandé; Strict selon UX)
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax

# ─────────────────────────────────────────────────────────────────────────────
# Logging
# ─────────────────────────────────────────────────────────────────────────────
DJANGO_LOG_LEVEL=INFO
SQL_LOG_LEVEL=WARNING

# ─────────────────────────────────────────────────────────────────────────────
# Outils internes / intégrations
# ─────────────────────────────────────────────────────────────────────────────
# Emplacement absolu (optionnel) pour la lecture sécurisée des fichiers frontend
# FRONTEND_APP_PATH=/abs/path/to/pixelprowlers_studio/frontend/app

# Clé de sauvegarde/restauration (Fernet, base64 urlsafe 32 bytes)
# Générer: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BACKUP_KEY=REPLACE_WITH_FERNET_KEY

# ─────────────────────────────────────────────────────────────────────────────
# (Optionnels) Cache / File Storage / Email / Observabilité
# ─────────────────────────────────────────────────────────────────────────────
# REDIS_URL=redis://localhost:6379/0
# EMAIL_HOST=smtp.example.com
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=CHANGE_ME
# EMAIL_PORT=587
# EMAIL_USE_TLS=1
# SENTRY_DSN=
